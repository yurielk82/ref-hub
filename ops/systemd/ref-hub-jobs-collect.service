# ref-hub 공고 모음 — 사람인 채용 공고를 받아 JOBS_DATA_DIR/postings.json에 합친다.
# 원본: ref-hub ops/systemd/ (설치 방법은 같은 폴더 README.md)
# 사람인 키 파일이 생기기 전에는 실행을 건너뛴다(실패가 아니다).
[Unit]
Description=ref-hub jobs board - Saramin posting collection
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/ubuntu/.config/secrets/saramin-api.env
OnFailure=ops-alert-unit-failure@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
# 배포한 커밋에 고정된 운영 사본에서 실행한다(기본 체크아웃은 쓰지 않는다).
WorkingDirectory=/home/ubuntu/GitHub/.release/ref-hub
EnvironmentFile=/home/ubuntu/.config/secrets/saramin-api.env
Environment=PATH=/home/ubuntu/.local/share/node/current/bin:/usr/bin:/bin
Environment=TZ=Asia/Seoul
Environment=JOBS_DATA_DIR=/home/ubuntu/.local/share/ref-hub/jobs
ExecStart=/home/ubuntu/.local/share/node/current/bin/node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/collect-jobs.ts
TimeoutStartSec=300
Slice=batch.slice
AllowedCPUs=1-3
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ref-hub-jobs-collect
